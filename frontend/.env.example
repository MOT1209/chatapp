# Copy to .env and adjust for your local backend.
# The frontend reads these at build time via import.meta.env.

# Base origin of the REST API — no /api suffix. Every call already includes
# the /api prefix itself (see src/lib/api.ts), so VITE_API_URL + path would
# double up to /api/api/... if you add it here.
VITE_API_URL=http://localhost:4000

# Base URL of the WebSocket endpoint. No /api prefix here.
VITE_WS_URL=ws://localhost:4000/ws
