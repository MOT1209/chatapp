# --- Server ---
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

# --- Database ---
# Replace user, password, host, and db name for your environment.
# NEVER commit the real .env file.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/chatapp?schema=public"

# --- Auth ---
# Generate strong secrets locally with:  openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# bcrypt cost factor for password hashing. 10-12 is a reasonable range;
# higher is slower but more resistant to offline cracking.
BCRYPT_ROUNDS=10

# --- Email (optional) ---
# Password-reset email is sent only when BOTH of these are set; otherwise the
# reset endpoint still works but sends nothing (see src/lib/mailer.ts).
# Resend: https://resend.com — create an API key and verify your sender domain.
# RESEND_API_KEY=re_xxxxxxxx
# MAIL_FROM=ChatApp <no-reply@your-verified-domain.com>
# Optional web client origin; when set, reset emails also include a clickable link.
# APP_WEB_URL=https://chat.example.com
