# --- Server ---
NODE_ENV=development
PORT=4000
# Exact origin(s) only. A wildcard is rejected in production because the API
# serves credentialed CORS for the web refresh cookie.
# Comma-separate to allow several, e.g. https://app.example.com,https://admin.example.com
CORS_ORIGIN=http://localhost:5173

# --- Database ---
# Replace user, password, host, and db name for your environment.
# NEVER commit the real .env file.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/chatapp?schema=public"

# --- Auth ---
# Generate strong secrets locally with:  openssl rand -base64 48
#
# Any variable below also accepts a `*_FILE` variant that holds the value in a
# file, e.g. JWT_ACCESS_SECRET_FILE=/run/secrets/jwt_access. The file is read at
# startup and trimmed of one trailing newline; the literal variable wins if both
# are set. Use this for container/Kubernetes secret mounts so credentials do not
# have to appear in an environment dump or a process listing.
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
# JWT_ACCESS_SECRET_FILE=/run/secrets/jwt_access
# JWT_REFRESH_SECRET_FILE=/run/secrets/jwt_refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# bcrypt cost factor for password hashing. 10-12 is a reasonable range;
# higher is slower but more resistant to offline cracking.
BCRYPT_ROUNDS=10# --- Password reset email (SMTP) ---
# REQUIRED in production: the API refuses to start without it, because a reset
# flow with nowhere to send the token cannot complete.
# Outside production the API starts without these and simply sends no mail.
#
# APP_BASE_URL is the web app's origin. It is used to build the reset link, so it
# must be the address a user can actually click — https in production.
APP_BASE_URL=http://localhost:5173
SMTP_HOST=localhost
SMTP_PORT=1025
# true for implicit TLS (usually port 465), false for STARTTLS (usually 587).
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# SMTP_PASS_FILE=/run/secrets/smtp_password
SMTP_FROM=no-reply@example.com
SMTP_FROM_NAME=ChatApp

# How long a reset link stays usable.
PASSWORD_RESET_TOKEN_TTL_MINUTES=60
# Per-account cooldown on forgot-password. A second request inside this window is
# silently ignored and mints no token, so the endpoint cannot be used to hammer
# one mailbox. Silent by design: the response is identical either way.
PASSWORD_RESET_COOLDOWN_SECONDS=300

# --- Refresh cookie (web clients) ---
# The refresh token also travels in an HttpOnly cookie named chatapp_rt, scoped
# to /api/auth, so JavaScript cannot read it. These tune it.
# Secure is forced on in production; SameSite=None additionally requires Secure.
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
