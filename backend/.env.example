# ChatApp backend configuration
#
# Copy to `.env` and fill in. `.env` is gitignored — never commit real secrets.
# Every variable is validated at startup by src/config/env.ts: a missing or
# malformed value stops the process with a named field error rather than booting
# into an unsafe default.
#
# Line format: NAME=<value>   # required | optional (default: X) | any allowed value

# --- Server ---
# Allowed: development | test | production.
# `production` enables every strict check (secret strength, HTTPS reset links,
# explicit CORS origins, mandatory SMTP). `test` disables the rate limiters and
# relaxes those checks, so it additionally requires a loopback DATABASE_URL and
# refuses to start against a remote one.
NODE_ENV=development
# Any free TCP port. Default: 4000
PORT=4000
# Comma-separated list of exact allowed origins. A wildcard is rejected in
# production, because the API serves credentialed CORS for the refresh cookie.
# Default: http://localhost:5173
CORS_ORIGIN=http://localhost:5173
# Required. Number of reverse proxies in front of the API. Every per-IP rate
# limiter keys on req.ip, which Express derives from this: too high and a client
# can spoof X-Forwarded-For to bypass the auth limiters, too low and every user
# behind the proxy shares one bucket. Use 1 for a single reverse proxy (the usual
# case), 0 for a directly exposed server. Default: 1
TRUST_PROXY=1

# --- Database ---
# Required. PostgreSQL connection string. Under NODE_ENV=test the host must be
# loopback (localhost / 127.0.0.1 / ::1 / 0.0.0.0) or startup is refused.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/chatapp?schema=public"

# --- Auth ---
# Required. Generate strong secrets locally with:  openssl rand -base64 48
#
# In production each must be at least 32 characters, must not be a known
# placeholder, and the two must differ from each other — the server refuses to
# boot otherwise. Short throwaway values are fine in development and test.
#
# DATABASE_URL, JWT_ACCESS_SECRET, JWT_REFRESH_SECRET, SMTP_USER and SMTP_PASS also
# accept a `*_FILE` variant holding the value in a file,
# e.g. JWT_ACCESS_SECRET_FILE=/run/secrets/jwt_access. The file is read at startup
# and trimmed of one trailing newline. A literal variable always wins over its
# file, so a stale mount can never shadow a correctly rotated secret. Use this for
# Docker/Kubernetes/systemd secret mounts so credentials stay out of environment
# dumps and process listings.
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
# JWT_ACCESS_SECRET_FILE=/run/secrets/jwt_access
# JWT_REFRESH_SECRET_FILE=/run/secrets/jwt_refresh
# Access token lifetime, e.g. 45s / 15m / 1h / 30d. Default: 15m
JWT_ACCESS_TTL=15m
# Refresh token lifetime (and the session row + cookie Max-Age that follow it).
# Default: 30d
JWT_REFRESH_TTL=30d
# bcrypt cost factor for password hashing. 10-12 is a reasonable range: higher is
# slower to hash but more resistant to offline cracking. The test suite overrides
# this to 4 for speed. Default: 10
BCRYPT_ROUNDS=10

# --- Password reset email (SMTP) ---
# REQUIRED in production: the API refuses to start without a transport, because a
# reset flow with nowhere to send the token can never complete. Outside
# production the API starts without these and simply sends no mail.
#
# APP_BASE_URL is the web app's public origin; the reset link is built from it and
# must be https in production, because it is emailed to users.
APP_BASE_URL=http://localhost:5173
SMTP_HOST=localhost
SMTP_PORT=1025
# true for implicit TLS (usually port 465), false for STARTTLS (usually 587).
# Default: false
SMTP_SECURE=false
# SMTP_USER and SMTP_PASS must both be set or both be empty.
SMTP_USER=
SMTP_PASS=
# SMTP_PASS_FILE=/run/secrets/smtp_password
# Envelope sender (MAIL FROM) — must be a mailbox your provider allows to use.
SMTP_FROM=no-reply@example.com
SMTP_FROM_NAME=ChatApp
# How long a reset link stays usable. 1–1440. Default: 60
PASSWORD_RESET_TOKEN_TTL_MINUTES=60
# Per-account cooldown between reset emails. 0–3600, default 300. A second
# request inside this window is silently ignored and mints no token, so the
# endpoint cannot be used to hammer one mailbox. Silent by design: the response is
# identical either way.
PASSWORD_RESET_COOLDOWN_SECONDS=300

# --- Refresh cookie (web clients) ---
# The refresh token also travels in an HttpOnly cookie named chatapp_rt, scoped to
# /api/auth, so JavaScript cannot read it. These tune it.
# Secure is forced on in production; this flag only exists to pin it off in dev.
# Default: false
COOKIE_SECURE=false
# Allowed: lax | strict | none. Default: lax
# `lax` still sends the cookie on top-level navigations (which web clients need
# after a redirect) while blocking the cross-site POST that CSRF relies on.
# `none` requires COOKIE_SECURE=true (validated at startup).
COOKIE_SAME_SITE=lax
# Cookie path scope. Default: /api/auth
COOKIE_PATH=/api/auth

# --- Maintenance job (`npm run cleanup`) ---
# Deletes expired/revoked sessions and expired/used reset tokens in bounded
# batches. Safe to run on a live service: idempotent, batched, and it never
# touches rows that are still usable. Run it from cron or a platform scheduler
# (typically daily); one invocation is one bounded pass, not a daemon.
#
# Rows already past their expiry are always deleted regardless of retention. The
# retention windows only govern how long already-dead rows are kept for
# post-incident investigation.
# Rows deleted per statement (1–10000). Default: 500
CLEANUP_BATCH_SIZE=500
# Days to keep revoked (but not yet expired) sessions. 1–3650. Default: 30
SESSION_RETENTION_DAYS=30
# Days to keep used (but not yet expired) password-reset tokens. 1–3650. Default: 30
RESET_TOKEN_RETENTION_DAYS=30

# --- Sessions ---
# Seconds after a refresh token is rotated during which presenting it again is treated as a
# race between two browser tabs (they share one refresh cookie), not as theft: the stale
# token is refused but the user's sessions are kept. After this, reuse revokes every session.
# 0 = always treat reuse as theft. Range 0-60.
REFRESH_REUSE_GRACE_SECONDS=10

# --- Development conveniences ---
# Print the password-reset link to the server console when no SMTP is configured. A reset
# link is a credential, so this is off by default, only honoured when NODE_ENV=development,
# and production refuses to start with it enabled.
DEV_LOG_RESET_TOKEN=false

# --- Realtime (WebSocket) ---
# Simultaneous authenticated sockets one account may hold (tabs, devices, and
# half-dead connections the heartbeat has not reaped yet). A socket over the limit
# is refused with close code 4429; existing sockets are never evicted. 1-100.
WS_MAX_CONNECTIONS_PER_USER=10