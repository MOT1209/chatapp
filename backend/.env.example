# --- Server ---
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

# --- Database ---
# Replace user, password, host, and db name for your environment.
# NEVER commit the real .env file.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/chatapp?schema=public"

# --- Auth (Phase 0: placeholders — no auth logic implemented yet) ---
# Generate strong secrets locally with:  openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
